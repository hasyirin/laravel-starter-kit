{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "dev": "vp dev",
        "lint": "vp lint --fix && vp fmt resources/ && prettier --write resources/views",
        "test:lint": "vp lint --deny-warnings && vp fmt --check resources/ && prettier --check resources/views"
    },
    "dependencies": {
        "@laravel/passkeys": "^0.4.1",
        "@tailwindcss/vite": "^4.3.5",
        "concurrently": "^10.0.7",
        "fontaine": "^1.0.3",
        "laravel-vite-plugin": "^3.2.1",
        "prettier": "3.9.10",
        "prettier-plugin-blade": "3.3.3",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "^4.3.5",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
        "vite-plus": "1.5.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.5",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun"
        }
    },
    "devDependencies": {
        "playwright": "^1.65.0"
    }
}
