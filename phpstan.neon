includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - ./vendor/calebdw/larastan-livewire/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 10

    checkModelProperties: true

    checkConfigTypes: true

    checkOctaneCompatibility: true

    checkBenevolentUnionTypes: true

    checkMissingCallableSignature: true

    checkTooWideReturnTypesInProtectedAndPublicMethods: true

    checkTooWideThrowTypesInProtectedAndPublicMethods: true

    checkUninitializedProperties: true

    additionalConstructors:
        - App\Domain\Shared\Common\Seeders\Seeder::run
        - App\Domain\Shared\Common\Seeders\Seeder::before

    reportAnyTypeWideningInVarTag: true

    reportIgnoresWithoutComments: true

    reportUnmatchedIgnoredErrors: true

    tmpDir: storage/phpstan/

    ignoreErrors:
        - identifier: cast.string
          reportUnmatched: false
        - identifier: cast.int
          reportUnmatched: false
